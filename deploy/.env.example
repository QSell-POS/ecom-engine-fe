# Copy to the repo root as .env on the EC2 instance:
#   cp deploy/.env.example .env && nano .env
# docker compose reads it, so a value change needs only `bash deploy/deploy.sh`
# (a NEXT_PUBLIC_* change also needs the rebuild that deploy.sh does anyway —
# see the bottom section).

# ---------------------------------------------------------------------------
# Backend (read at request time by the server — never sent to the browser)
# ---------------------------------------------------------------------------

# No trailing slash.
API_URL=https://api.qsellpos.com

# This deployment is the hosted storefront for every tenant on *.qsellpos.com,
# so it needs a PLATFORM key, not a merchant's own storefront key — see
# docs/storefront-integration.md. Minted server-side on the API box:
#   npm run platform:create-key
# Never ship this to a browser: it reads every store's catalog.
API_KEY=ek_platform_replace_me

# ---------------------------------------------------------------------------
# Domains (Nginx server_name, and the certificate it requests)
# ---------------------------------------------------------------------------

# The dashboard's own host. Any other host is resolved as a tenant's
# storefront via /storefront/resolve — see src/proxy.ts.
ADMIN_DOMAIN=admin.qsellpos.com

# The wildcard: every tenant's storefront lives at <subdomain>.ROOT_DOMAIN.
# Needs a wildcard DNS record (*.qsellpos.com, already set up in Cloudflare)
# and a wildcard certificate, which — unlike a normal one — has to be issued
# over DNS-01, not the usual HTTP-01 challenge. See CLOUDFLARE_API_TOKEN below.
ROOT_DOMAIN=qsellpos.com

# A Cloudflare API token, scoped to Zone:DNS:Edit on this zone only — create
# one at Cloudflare > My Profile > API Tokens > Create Token > "Edit zone DNS"
# template, restricted to the qsellpos.com zone. Used only by
# `deploy/deploy.sh --tls` to answer the DNS-01 challenge; never sent to the
# app itself.
CLOUDFLARE_API_TOKEN=replace_me

# Where Let's Encrypt sends expiry warnings.
CERTBOT_EMAIL=you@qsellpos.com

# ---------------------------------------------------------------------------
# Single-tenant alternative
# ---------------------------------------------------------------------------
# If this deployment is instead one merchant's own storefront (not the hosted
# platform above), delete ROOT_DOMAIN/CLOUDFLARE_API_TOKEN, use a storefront
# key for API_KEY, and set these two instead — then the HTTP-01 certificate
# flow in deploy.sh's "Single-tenant" comment applies, not the wildcard one.
#   SHOP_DOMAIN=shop.yourdomain.com
#   NEXT_PUBLIC_STORE_SLUG=my-store   # set as a GitHub Actions repo variable, see below

# ---------------------------------------------------------------------------
# GHCR: where the image comes from
# ---------------------------------------------------------------------------

# The repo is private, so its package is too. A GitHub personal access token
# with read:packages only — nothing else. GitHub > Settings > Developer
# settings > Personal access tokens > Tokens (classic).
GHCR_USER=your-github-username
GHCR_TOKEN=ghp_replace_me

# Override to deploy a specific build, e.g. to roll back to a known commit:
#   WEB_IMAGE=ghcr.io/qsell-pos/ecom-engine-fe:<sha>
# WEB_IMAGE=ghcr.io/qsell-pos/ecom-engine-fe:production

# ---------------------------------------------------------------------------
# Browser-visible (inlined into the image at build time, by GitHub Actions —
# NOT read from this file. Set the same names as repository VARIABLES in
# GitHub: Settings > Secrets and variables > Actions > Variables. The copies
# below only matter for a local `deploy/deploy.sh --build`.)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_DEFAULT_CURRENCY=NPR

NEXT_PUBLIC_API_URL=https://api.qsellpos.com

# Must match ADMIN_DOMAIN above — this is the build-time copy src/proxy.ts
# actually reads. (GitHub variable name: ADMIN_DOMAIN.)
NEXT_PUBLIC_ADMIN_DOMAIN=admin.qsellpos.com

# Leave unset for the hosted platform above. Set only for the single-tenant
# alternative, to the same value as its SHOP_DOMAIN's slug. (GitHub variable
# name: STORE_SLUG.)
# NEXT_PUBLIC_STORE_SLUG=

# The Cloudflare R2 public hostname, to allow next/image to optimise product
# images. Leave blank to serve them unoptimised.
R2_PUBLIC_HOST=
