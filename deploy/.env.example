# Copy to the repo root as .env on the EC2 instance:
#   cp deploy/.env.example .env && nano .env
# docker compose reads it, so a value change needs only `bash deploy/deploy.sh`
# (a NEXT_PUBLIC_* change also needs the rebuild that deploy.sh does anyway).

# ---------------------------------------------------------------------------
# Backend (read at request time by the server — never sent to the browser)
# ---------------------------------------------------------------------------

# No trailing slash.
API_URL=https://api.abhishekpun.com.np

# A storefront key from the dashboard: Settings > API keys > New key. It is
# shown once. This is the tenant whose catalog this deployment serves.
API_KEY=ek_live_replace_me

# ---------------------------------------------------------------------------
# Domains (Nginx server_name, and the certificate it requests)
# ---------------------------------------------------------------------------

# One deployment serves both. Which site a request gets is decided by its
# Host header: ADMIN_DOMAIN is the dashboard, anything else is the public shop.
ADMIN_DOMAIN=admin.yourdomain.com
SHOP_DOMAIN=shop.yourdomain.com

# The store the shop domain serves at its root, and the name it shows until a
# theme is saved. Inlined at build time, so a change needs a rebuild.
STORE_SLUG=my-store
STORE_NAME=My Store

# Where Let's Encrypt sends expiry warnings.
CERTBOT_EMAIL=you@yourdomain.com

# ---------------------------------------------------------------------------
# GHCR: where the image comes from
# ---------------------------------------------------------------------------

# The repo is private, so its package is too. A GitHub personal access token
# with read:packages only — nothing else. GitHub > Settings > Developer
# settings > Personal access tokens > Tokens (classic).
GHCR_USER=your-github-username
GHCR_TOKEN=ghp_replace_me

# Override to deploy a specific build, e.g. to roll back to a known commit:
#   WEB_IMAGE=ghcr.io/qsell-pos/ecom-engine-fe:<sha>
# WEB_IMAGE=ghcr.io/qsell-pos/ecom-engine-fe:production

# ---------------------------------------------------------------------------
# Browser-visible (inlined into the image at build time, by GitHub Actions)
# ---------------------------------------------------------------------------

# Set these as repository VARIABLES in GitHub too (Settings > Secrets and
# variables > Actions > Variables) — that is where the image build reads them.
# The copies here only matter for a local `--build`.

NEXT_PUBLIC_DEFAULT_CURRENCY=NPR

# Only needed if the browser talks to the API directly (the chat WebSocket).
NEXT_PUBLIC_API_URL=https://api.abhishekpun.com.np

# The Cloudflare R2 public hostname, to allow next/image to optimise product
# images. Leave blank to serve them unoptimised.
R2_PUBLIC_HOST=
