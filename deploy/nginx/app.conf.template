# Two server names, one app: the dashboard and the storefront are route groups
# in the same Next.js server, so both proxy to the same upstream.

upstream nextjs {
    server web:3000;
    keepalive 32;
}

# No ACME-challenge location needed on :80 — the wildcard certificate below
# is issued over DNS-01 (deploy/deploy.sh --tls), not HTTP-01 — but :80 still
# redirects, since a bookmarked http:// link should still work.
server {
    listen 80;
    listen [::]:80;
    server_name ${ADMIN_DOMAIN} ${ROOT_DOMAIN} *.${ROOT_DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # http2 on, not "listen … http2", which Nginx 1.25+ deprecated.
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    # ADMIN_DOMAIN is covered by the wildcard below when it is a direct
    # subdomain of ROOT_DOMAIN; listed explicitly anyway in case it one day
    # isn't.
    server_name ${ADMIN_DOMAIN} ${ROOT_DOMAIN} *.${ROOT_DOMAIN};

    # Requested as one cert for ROOT_DOMAIN + *.ROOT_DOMAIN, so it lives under
    # ROOT_DOMAIN's own directory regardless of which host is being served.
    ssl_certificate     /etc/letsencrypt/live/${ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ROOT_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Uploads go through the app to /admin/media; the API caps a body at 110 MB.
    client_max_body_size 110m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hashed build assets are immutable, so they can be cached hard.
    location /_next/static/ {
        proxy_pass http://nextjs;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://nextjs;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Server Components stream their payload; buffering would hold the
        # whole response until the render finished.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;

        # The chat inbox opens a WebSocket to the API, not here, but leaving
        # the upgrade headers in place costs nothing and avoids a surprise.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
